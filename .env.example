# Drex Environment Variables
# Copy this file to .env and fill in real values.
# This file is gitignored and should never be committed.
#
# Note: These defaults align with Contextra's docker-compose infrastructure.
# If running alongside Contextra, use the same PostgreSQL and Redis instances.

# Application environment: development, staging, or production
# DREX_ENV=development

# Log level: trace, debug, info, warn, error
# DREX__LOG_LEVEL=info

# Database configuration
# Default matches Contextra's docker-compose credentials
# DREX__DATABASE__URL=postgres://postgres:postgrespassword@localhost:5432/drex
# DREX__DATABASE__MAX_CONNECTIONS=10

# Redis configuration
# DREX__REDIS__URL=redis://localhost:6379

# Note: Use double underscores (__) to separate nested keys.
# Example: DREX__DATABASE__URL sets database.url
# Example: DREX__DATABASE__MAX_CONNECTIONS sets database.max_connections
