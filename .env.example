# Drex Environment Variables
# Copy this file to .env and fill in real values.
# This file is gitignored and should never be committed.
#
# See README.md for complete setup instructions.

# Application environment: development, staging, or production
DREX_ENV=development

# Log level: trace, debug, info, warn, error
DREX__LOG_LEVEL=info

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL for state persistence.
# Default matches docker-compose.yml postgres credentials
DREX__DATABASE__URL=postgres://postgres:postgrespassword@localhost:5432/drex
DREX__DATABASE__MAX_CONNECTIONS=10

# =============================================================================
# Redis Configuration
# =============================================================================
# Redis for caching, sessions, and pub/sub.
# Default matches docker-compose.yml redis service
DREX__REDIS__URL=redis://localhost:6379

# =============================================================================
# Ollama Configuration
# =============================================================================
# Ollama local LLM server for model inference
DREX__OLLAMA__BASE_URL=http://localhost:11434
DREX__OLLAMA__DEFAULT_MODEL=gemma3:4b
DREX__OLLAMA__TIMEOUT_SECONDS=120

# =============================================================================
# Contextra Configuration
# =============================================================================
# Contextra Gateway provides persistent memory and context services.
# You must start Contextra Gateway separately - see README.md for instructions.
DREX__CONTEXTRA__GATEWAY_URL=http://localhost:3000
# DREX__CONTEXTRA__API_KEY=your_api_key_here  # Only if Contextra requires auth
DREX__CONTEXTRA__TIMEOUT_SECONDS=30

# =============================================================================
# Qdrant Configuration
# =============================================================================
# Qdrant vector database for semantic memory.
# Required even when using Contextra - Drex may use Qdrant directly.
# Start with: docker compose up -d qdrant
DREX__QDRANT__URL=http://localhost:6333
# DREX__QDRANT__API_KEY=your_qdrant_api_key_here  # Only if Qdrant requires auth

# =============================================================================
# Notes
# =============================================================================
# - Use double underscores (__) to separate nested keys in environment variables
# - DREX__DATABASE__URL sets database.url
# - DREX__OLLAMA__DEFAULT_MODEL sets ollama.default_model
# - For local development, these defaults should work with docker-compose.yml
